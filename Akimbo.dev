<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>AKIMBO HOSTING</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23e11d48'/%3E%3Cpath d='M16 6 7 26h5l4-10 4 10h5z' fill='%23070709'/%3E%3C/svg%3E">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#070709;--pn:#101014;--bd:rgba(255,255,255,.08);--tx:#ececf1;--mu:#8b8b98;--rd:#e11d48;--ok:#22c55e;--wn:#f59e0b;color-scheme:dark;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);background:var(--bg)}
body{background:var(--bg);color:var(--tx);font:14px/1.5 Inter,system-ui,-apple-system,"Segoe UI",sans-serif;min-height:100%}
h1{font-size:24px;letter-spacing:-.02em}h3{margin-bottom:12px}.mu,small{color:var(--mu)}small{font-size:12px;text-transform:uppercase;letter-spacing:.08em}
.gl{background:rgba(16,16,20,.74);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid var(--bd);border-radius:18px;box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 40px rgba(225,29,72,.07)}
#lg{position:fixed;inset:0;display:grid;place-items:center;padding:20px;background:radial-gradient(60% 50% at 50% 0,rgba(225,29,72,.18),transparent),var(--bg);z-index:9}
#lg[hidden]{display:none}
#cv{position:absolute;inset:0;width:100%;height:100%;opacity:.55}
#lc{position:relative;width:100%;max-width:380px;padding:34px 30px;text-align:center}
#lc .wm{font-weight:800;letter-spacing:.38em;font-size:22px;margin:12px 0 2px}
input,select{width:100%;background:#0b0b0e;border:1px solid var(--bd);color:var(--tx);border-radius:10px;padding:11px 13px;font:inherit;margin:6px 0 12px;min-height:44px}
input:focus,select:focus{outline:none;border-color:var(--rd);box-shadow:0 0 0 3px rgba(225,29,72,.18)}
label{display:block;text-align:left;font-size:12px;color:var(--mu)}
.bt{background:linear-gradient(135deg,#e11d48,#9f1239);color:#fff;border:0;border-radius:10px;padding:10px 16px;font:600 14px inherit;cursor:pointer;min-height:44px;transition:.2s;box-shadow:0 6px 20px rgba(225,29,72,.25)}
.bt:hover{transform:translateY(-1px);filter:brightness(1.1)}.bt:disabled{opacity:.5}
.bt.s{background:#17171d;border:1px solid var(--bd);box-shadow:none;color:var(--tx);min-height:36px;padding:6px 12px;font-weight:500}.bt.dg{color:#fb7185}
.err{color:#fb7185;min-height:20px;font-size:13px;margin-bottom:8px}.tiny{font-size:11px;color:var(--mu);margin-top:14px}
#sb{position:fixed;top:0;bottom:0;left:0;width:240px;background:var(--pn);border-right:1px solid var(--bd);padding:calc(18px + env(safe-area-inset-top,0px)) 12px calc(14px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:2px;z-index:5;transition:transform .25s;overflow-y:auto}
.lo{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:.3em;padding:0 8px 18px}
#nv{flex:1}.nv{display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:10px;color:var(--mu);cursor:pointer;transition:.15s;min-height:42px}
.nv i{width:18px;font-style:normal;text-align:center}.nv:hover{background:#17171d;color:var(--tx)}.nv.on{background:rgba(225,29,72,.12);color:#fff;box-shadow:inset 2px 0 var(--rd)}
.me{border-top:1px solid var(--bd);padding:12px 8px 0}.me b{display:block}
#mn{margin-left:240px;padding:28px;max-width:1240px}
#tp{display:none;position:sticky;top:env(safe-area-inset-top,0px);z-index:4;background:rgba(7,7,9,.85);backdrop-filter:blur(12px);padding:10px 14px;align-items:center;gap:10px;border-bottom:1px solid var(--bd)}
.hd{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:18px}.hd h1{flex:1}.hd p{width:100%}
.card{background:linear-gradient(180deg,rgba(255,255,255,.03),transparent),var(--pn);border:1px solid var(--bd);border-radius:16px;padding:16px;margin-bottom:14px;transition:.2s}
.card:hover{border-color:rgba(225,29,72,.35);box-shadow:0 0 28px rgba(225,29,72,.08)}
.card>b{display:block;font-size:22px;margin-top:2px}.grid,.grid2{display:grid;gap:14px;margin:18px 0 4px}
.grid{grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}.grid2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}.grid .card,.grid2 .card{margin:0}
.ok{color:var(--ok);font-size:12px;font-weight:700}.wn{color:var(--wn);font-size:12px;font-weight:700}.bd{color:#fb7185;font-size:12px;font-weight:700}
.url{color:#fb7185;display:block;margin:4px 0 10px;word-break:break-all}
.kv{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}.kv span{font-size:12px;color:var(--mu)}.kv b{display:block;color:var(--tx);font-size:13px}
.acts{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.ch{width:100%;height:120px;display:block;margin-top:8px}
table{width:100%;border-collapse:collapse}th{text-align:left;color:var(--mu);font-size:12px;font-weight:500;padding:10px;border-bottom:1px solid var(--bd)}td{padding:10px;border-bottom:1px solid var(--bd);vertical-align:middle}
tr:hover td{background:rgba(255,255,255,.02)}td.ac{display:flex;gap:4px;flex-wrap:wrap}
.tb{display:flex;gap:10px}.tb input{flex:2}.tb select{flex:1}
.drop{border:1.5px dashed rgba(225,29,72,.4);border-radius:14px;padding:22px;text-align:center;color:var(--mu);cursor:pointer;margin-bottom:14px;transition:.2s}.drop.h,.drop:hover{background:rgba(225,29,72,.07);color:var(--tx)}
.seg{display:flex;background:var(--pn);border:1px solid var(--bd);border-radius:10px;overflow:hidden}.seg button{background:0;border:0;color:var(--mu);padding:8px 14px;cursor:pointer;min-height:38px}.seg .on{background:rgba(225,29,72,.18);color:#fff}
.bar{display:flex;align-items:center;gap:10px;margin:10px 0}.bar span,.bar em{width:44px;font-style:normal;font-size:12px;color:var(--mu)}.bar i{flex:1;height:8px;background:#1b1b22;border-radius:9px;overflow:hidden}.bar u{display:block;height:100%;background:linear-gradient(90deg,#9f1239,#e11d48)}
.stg{display:flex;gap:6px;margin:14px 0;flex-wrap:wrap}.stg span{flex:1;min-width:90px;text-align:center;padding:9px 6px;border-radius:10px;background:#17171d;color:var(--mu);font-size:12px;transition:.3s}.stg .on{background:rgba(225,29,72,.18);color:#fff;box-shadow:0 0 16px rgba(225,29,72,.2)}
pre{background:#050507;border:1px solid var(--bd);border-radius:12px;padding:14px;min-height:150px;font:12.5px/1.7 ui-monospace,Menlo,monospace;color:#86efac;overflow:auto;white-space:pre-wrap}
.win{border:1px solid rgba(34,197,94,.4);background:rgba(34,197,94,.07);border-radius:14px;padding:14px;margin-top:14px}
#md{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);place-items:center;padding:16px;z-index:20}#md.on{display:grid}.mc{width:100%;max-width:440px;padding:22px;max-height:90vh;overflow:auto}
#ts{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);background:#1b1b22;border:1px solid var(--bd);padding:10px 16px;border-radius:12px;opacity:0;pointer-events:none;transition:.25s;z-index:30}#ts.on{opacity:1;transform:translate(-50%,0)}
.row{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid var(--bd);flex-wrap:wrap}
@media(max-width:860px){#sb{transform:translateX(-100%)}#sb.o{transform:none;box-shadow:0 0 80px #000}#mn{margin-left:0;padding:16px}#tp{display:flex}.tb{flex-direction:column;gap:0}
table,thead,tbody,tr,td{display:block}thead{display:none}tr{background:var(--pn);border:1px solid var(--bd);border-radius:14px;padding:8px;margin-bottom:10px}td{border:0;padding:5px 8px}td[data-l]::before{content:attr(data-l)": ";color:var(--mu);font-size:12px}tr:hover td{background:0}}
</style></head><body>
<div id="lg"><canvas id="cv"></canvas><form id="lf" class="gl" id="lc" style="position:relative;width:100%;max-width:380px;padding:34px 30px;text-align:center" autocomplete="off">
<div id="lgo"></div><div class="wm" style="font-weight:800;letter-spacing:.38em;font-size:22px;margin:12px 0 2px;padding-left:.38em">AKIMBO</div><p class="mu" style="margin-bottom:22px">Private Hosting Platform</p>
<label>Username<input id="u" autocomplete="username"></label><label>Password<input id="p" type="password" autocomplete="current-password"></label>
<div class="err" id="le"></div><button class="bt" style="width:100%">Sign In</button><p class="mu" style="margin-top:16px;font-size:12px">Secure access for authorized users only.</p><p class="tiny">Preview build · no backend connected</p></form></div>
<div id="app" hidden><aside id="sb"><div class="lo"><span class="LG"></span>AKIMBO</div><nav id="nv"></nav><div class="me"><b>KyleXAkimbo</b><small style="text-transform:none;letter-spacing:0">Administrator</small><div class="acts"><button class="bt s" data-a="out" style="width:100%">Logout</button></div></div></aside>
<div id="tp"><button class="bt s" data-a="menu">☰</button><span class="LG"></span><b style="letter-spacing:.3em">AKIMBO</b></div><main id="mn"></main></div>
<div id="md"></div><div id="ts"></div><input type="file" id="fi" multiple hidden>
<script>
const $=s=>document.querySelector(s),E=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const LG='<svg viewBox="0 0 32 32" width="32" height="32"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fb7185"/><stop offset="1" stop-color="#9f1239"/></linearGradient></defs><rect width="32" height="32" rx="9" fill="url(#g)"/><path d="M16 6 7 26h5l4-10 4 10h5z" fill="#070709"/></svg>';
document.querySelectorAll('.LG').forEach(e=>e.innerHTML=LG);$('#lgo').innerHTML=LG.replace('width="32" height="32"','width="52" height="52"');
const N=[['dashboard','Dashboard','◧'],['projects','Projects','▣'],['files','Files','❏'],['deployments','Deployments','⇪'],['domains','Domains','◎'],['analytics','Analytics','▤'],['api','API','⌘'],['server','Server','▥'],['users','Users','☰'],['settings','Settings','⚙']];
$('#nv').innerHTML=N.map(n=>`<a class="nv" data-a="go" data-i="${n[0]}"><i>${n[2]}</i>${n[1]}</a>`).join('');
let page,tm,rg='7D',q='',so='n',cur=0,cbk;
const P=[{n:'nebula-docs',d:'Documentation portal',t:'Static site',s:'12.4 MB',b:'3.1 GB',r:'48.2K',rt:'42 ms',dp:'2h ago',c:'Aug 12, 2026'},{n:'loader-cdn',d:'Lua script delivery',t:'Assets / CDN',s:'1.2 MB',b:'118 GB',r:'3.9M',rt:'18 ms',dp:'1d ago',c:'Jul 02, 2026'},{n:'kyle-portfolio',d:'Personal portfolio',t:'Static site',s:'38.7 MB',b:'9.4 GB',r:'212K',rt:'51 ms',dp:'6d ago',c:'May 20, 2026'}];
const F=[{n:'assets',t:'Folder',s:0,m:'Yesterday',d:1},{n:'index.html',t:'HTML',s:4.2,m:'Today'},{n:'styles.css',t:'CSS',s:12.8,m:'Today'},{n:'app.js',t:'JS',s:86.5,m:'2h ago'},{n:'loader.lua',t:'LUA',s:3.1,m:'1d ago'},{n:'config.json',t:'JSON',s:0.8,m:'3d ago'},{n:'hero.png',t:'PNG',s:742,m:'5d ago'}];
const K=[{n:'CI deploy key',p:['deploy','read'],u:'1,240',k:'ak_live_••••3f9a'},{n:'Analytics reader',p:['read'],u:'318',k:'ak_live_••••b71c'}];
const DM=[{d:'nebula-docs.akimbo.host',s:'Verified',l:'Active'},{d:'docs.example.com',s:'Pending',l:'Provisioning'},{d:'cdn.example.org',s:'Configuration Required',l:'Not issued'}];
const DH=[{p:'nebula-docs',t:'2h ago',s:'Success'},{p:'loader-cdn',t:'1d ago',s:'Success'},{p:'kyle-portfolio',t:'6d ago',s:'Success'}];
const US=[['KyleXAkimbo','Administrator','Active'],['collaborator','Editor','Active'],['reviewer','Viewer','Suspended']];
const fs=k=>k>1024?(k/1024).toFixed(1)+' MB':k.toFixed(1)+' KB',sn=s=>s.replace(/[\\/]/g,'').replace(/\.{2,}/g,'.').replace(/^\./,'').slice(0,80),T=m=>{const t=$('#ts');t.textContent=m;t.className='on';clearTimeout(T.t);T.t=setTimeout(()=>t.className='',2300)};
const gen=(n,b,s)=>Array.from({length:n},(_,i)=>b*(1+.4*Math.sin(i/2+s)+.2*Math.sin(i*1.7+s*3)));
const ch=(a,col='#e11d48')=>{const w=600,h=140,m=Math.max(...a),l=a.map((v,i)=>(i?'L':'M')+(i*w/(a.length-1)).toFixed(1)+' '+(h-8-v/m*(h-24)).toFixed(1)).join(''),id='a'+col.slice(1);return `<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" class="ch"><defs><linearGradient id="${id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${col}" stop-opacity=".35"/><stop offset="1" stop-color="${col}" stop-opacity="0"/></linearGradient></defs><path d="${l}L${w} ${h}L0 ${h}Z" fill="url(#${id})"/><path d="${l}" fill="none" stroke="${col}" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>`};
const c=(l,v)=>`<div class="card"><small>${l}</small><b>${v}</b></div>`,M=h=>{$('#md').innerHTML=`<div class="gl mc">${h}</div>`;$('#md').className='on'};
const ask=(t,v,cb)=>{cbk=cb;M(`<h3>${t}</h3><input id="ai" value="${E(v)}"><div class="acts"><button class="bt" data-a="ok">Save</button><button class="bt s" data-a="x">Cancel</button></div>`);setTimeout(()=>$('#ai').focus(),50)};
const bdg=s=>`<span class="${s=='Verified'||s=='Success'||s=='Active'?'ok':s=='Pending'||s=='Provisioning'?'wn':'bd'}">● ${s}</span>`;
const V={};
V.dashboard=()=>`<div class="hd"><h1>Welcome back, KyleXAkimbo</h1><p class="mu">Manage your Akimbo hosting infrastructure.</p></div><div class="grid">${[['Total Projects',P.length],['Total Files',F.length],['Storage Used','1.8 GB'],['Bandwidth Used','312 GB'],['Total Requests','4.2M'],['Active Deployments',P.length],['Server Status','<span class="ok">● Operational</span>'],['Uptime','99.98%']].map(x=>c(...x)).join('')}</div><div class="card" style="margin-top:14px"><small>Requests · last 7 days</small>${ch(gen(28,50,1))}</div><div class="card"><small>Recent deployments</small>${DH.map(d=>`<div class="row"><span>${d.p}</span><span class="mu">${d.t}</span>${bdg(d.s)}</div>`).join('')}</div>`;
V.projects=()=>`<div class="hd"><h1>Projects</h1><button class="bt" data-a="newp">+ Create Project</button></div><div class="grid2">${P.map((p,i)=>`<div class="card"><div class="row" style="border:0;padding:0"><b>${E(p.n)}</b><span class="ok">● ONLINE</span></div><p class="mu">${E(p.d)}</p><span class="url">${E(p.n)}.akimbo.host</span><div class="kv">${[['Storage',p.s],['Bandwidth',p.b],['Requests',p.r],['Response Time',p.rt],['Last Deployment',p.dp],['Created',p.c]].map(k=>`<span>${k[0]}<b>${E(k[1])}</b></span>`).join('')}</div><div class="acts">${['Open','Deploy','Files','Settings','Delete'].map(a=>`<button class="bt s ${a=='Delete'?'dg':''}" data-a="p${a}" data-i="${i}">${a}</button>`).join('')}</div></div>`).join('')}</div>`;
const rows=()=>F.filter(f=>f.n.toLowerCase().includes(q.toLowerCase())).sort((a,b)=>so=='s'?b.s-a.s:so=='m'?0:a[so=='t'?'t':'n'].localeCompare(b[so=='t'?'t':'n'])).map(f=>{const i=F.indexOf(f);return `<tr><td data-l="Name">${f.d?'📁':'📄'} <b>${E(f.n)}</b><td data-l="Type">${f.t}<td data-l="Size">${f.d?'—':fs(f.s)}<td data-l="Modified">${f.m}<td class="ac">${['Preview','URL','Rename','Move','Download','Delete'].map(a=>`<button class="bt s ${a=='Delete'?'dg':''}" data-a="f${a}" data-i="${i}">${a=='URL'?'Copy URL':a}</button>`).join('')}`}).join('')||'<tr><td>No files match.';
V.files=()=>`<div class="hd"><h1>Files</h1><button class="bt" data-a="up">Upload</button><button class="bt s" data-a="nf">New Folder</button></div><div class="drop" id="dz">Drag &amp; drop files here, or tap to upload<br><small>HTML · CSS · JS · JSON · Lua · TXT · images · ZIP</small></div><div class="tb"><input id="sr" placeholder="Search files" value="${E(q)}"><select id="so">${[['n','Sort: Name'],['t','Sort: Type'],['s','Sort: Size']].map(o=>`<option value="${o[0]}" ${so==o[0]?'selected':''}>${o[1]}</option>`).join('')}</select></div><div class="card"><table><thead><tr><th>Name<th>Type<th>Size<th>Modified<th>Actions</thead><tbody id="tb">${rows()}</tbody></table></div>`;
V.deployments=()=>`<div class="hd"><h1>Deployments</h1></div><div class="card"><label>Project<select id="dp">${P.map((p,i)=>`<option ${i==cur?'selected':''}>${E(p.n)}</option>`).join('')}</select></label><button class="bt" id="db" data-a="run">Deploy</button><div class="stg" id="sg">${['Uploading','Processing','Building','Deploying','Online'].map(s=>`<span>${s}</span>`).join('')}</div><pre id="lgp">Waiting for deployment…</pre><div id="dr"></div></div><div class="card"><small>History</small>${DH.map(d=>`<div class="row"><span>${d.p}</span><span class="mu">${d.t}</span>${bdg(d.s)}</div>`).join('')}</div>`;
V.domains=()=>`<div class="hd"><h1>Domains</h1><button class="bt" data-a="nd">+ Add Domain</button></div><div class="card"><table><thead><tr><th>Domain<th>Status<th>SSL / HTTPS<th>Actions</thead>${DM.map((d,i)=>`<tr><td data-l="Domain">${E(d.d)}<td data-l="Status">${bdg(d.s)}<td data-l="SSL">${bdg(d.l)}<td class="ac"><button class="bt s" data-a="dv" data-i="${i}">Verify</button><button class="bt s dg" data-a="dd" data-i="${i}">Remove</button>`).join('')}</table></div><div class="card"><small>DNS configuration</small><pre style="min-height:0;color:#e5e5ea">CNAME  @                 edge.akimbo.host\nTXT    _akimbo-verify    akimbo-site-verification=&lt;shown by backend&gt;</pre></div>`;
V.analytics=()=>{const n={'24H':24,'7D':28,'30D':30,'90D':45}[rg];return `<div class="hd"><h1>Analytics</h1><div class="seg">${['24H','7D','30D','90D'].map(r=>`<button class="${r==rg?'on':''}" data-a="rg" data-i="${r}">${r}</button>`).join('')}</div></div><div class="grid2">${[['Requests',1,'#e11d48','4.2M'],['Visitors',2,'#a855f7','218K'],['Bandwidth',3,'#fb7185','312 GB'],['Response time',4,'#f59e0b','42 ms'],['Storage',5,'#22c55e','1.8 GB']].map(x=>`<div class="card"><small>${x[0]}</small><b>${x[3]}</b>${ch(gen(n,50,x[1]+n),x[2])}</div>`).join('')}<div class="card"><small>Status codes</small>${[['2xx',97.8],['3xx',1.4],['4xx',.7],['5xx',.1]].map(s=>`<div class="bar"><span>${s[0]}</span><i><u style="width:${Math.max(s[1],1.5)}%"></u></i><em>${s[1]}%</em></div>`).join('')}</div></div><div class="card" style="margin-top:14px"><small>Deployment history</small>${DH.map(d=>`<div class="row"><span>${d.p}</span><span class="mu">${d.t}</span>${bdg(d.s)}</div>`).join('')}</div>`};
V.api=()=>`<div class="hd"><h1>API</h1><button class="bt" data-a="nk">+ Generate Key</button></div>${K.map((k,i)=>`<div class="card"><div class="row" style="border:0;padding:0"><b>${E(k.n)}</b><code class="mu">${k.k}</code></div><p class="mu">${k.u} requests this month · permissions: ${k.p.map(E).join(', ')}</p><div class="acts"><button class="bt s" data-a="kr" data-i="${i}">Rename</button><button class="bt s dg" data-a="kd" data-i="${i}">Revoke</button></div></div>`).join('')||'<p class="mu">No active keys.</p>'}`;
V.users=()=>`<div class="hd"><h1>Users</h1></div><div class="card"><table><thead><tr><th>Username<th>Role<th>Status</thead>${US.map(u=>`<tr><td data-l="User"><b>${u[0]}</b><td data-l="Role">${u[1]}<td data-l="Status">${bdg(u[2])}`).join('')}</table></div>`;
V.settings=()=>`<div class="hd"><h1>Settings</h1></div><div class="grid2"><div class="card"><small>Owner profile</small><h3 style="margin-top:6px">KyleXAkimbo · Administrator</h3>${[['Username','KyleXAkimbo'],['Email','owner@akimbo.host'],['Account created','Jan 04, 2026'],['Last login',new Date().toLocaleString()],['Active sessions','2']].map(r=>`<div class="row"><span class="mu">${r[0]}</span><span>${r[1]}</span></div>`).join('')}<div class="acts"><button class="bt s" data-a="lo">Logout Other Sessions</button></div></div><div class="card"><small>Change password</small><label>Current password<input type="password" id="cp" autocomplete="current-password"></label><label>New password (12+ characters)<input type="password" id="np" autocomplete="new-password"></label><label>Confirm new password<input type="password" id="np2" autocomplete="new-password"></label><div class="err" id="pe"></div><button class="bt" data-a="pw">Change Password</button></div><div class="card"><small>Limits &amp; security</small><label>Storage limit (GB)<input type="number" value="50"></label><label>Bandwidth limit (GB / month)<input type="number" value="1000"></label><label>Session expiry<select><option>8 hours</option><option>24 hours</option><option>7 days</option></select></label><button class="bt s" data-a="sv">Save settings</button></div><div class="card"><small>Security log</small>${[['Sign-in · KyleXAkimbo','just now'],['Deployment · nebula-docs','2h ago'],['API key created','3d ago'],['Failed sign-in blocked (rate limit)','5d ago']].map(r=>`<div class="row"><span>${r[0]}</span><span class="mu">${r[1]}</span></div>`).join('')}</div></div>`;
const H={cpu:[30],mem:[55],net:[40]};
const draw=()=>{for(const k in H){H[k].push(Math.max(8,Math.min(95,H[k].at(-1)+(Math.random()-.5)*16)));if(H[k].length>30)H[k].shift()}const e=$('#sv');if(!e)return;const L=[['CPU Usage','cpu','%','#e11d48'],['Memory Usage','mem','%','#a855f7'],['Network','net',' Mb/s','#fb7185']];e.innerHTML=L.map(l=>`<div class="card"><small>${l[0]}</small><b>${H[l[1]].at(-1).toFixed(1)}${l[2]}</b>${ch(H[l[1]],l[3])}</div>`).join('')+`<div class="card"><small>Storage</small><b>1.8 / 50 GB</b><div class="bar"><i><u style="width:3.6%"></u></i></div></div><div class="card"><small>Uptime</small><b>41d 6h 12m</b></div>`};
V.server=()=>`<div class="hd"><h1>Akimbo Infrastructure</h1><span class="ok">● Operational</span></div><div class="grid2" id="sv"></div>`;
const go=p=>{page=p;clearInterval(tm);$('#sb').classList.remove('o');$('#mn').innerHTML=V[p]();document.querySelectorAll('.nv').forEach(n=>n.classList.toggle('on',n.dataset.i==p));if(p=='server'){draw();tm=setInterval(draw,1500)}if(p=='files'){$('#sr').oninput=e=>{q=e.target.value;$('#tb').innerHTML=rows()};$('#so').onchange=e=>{so=e.target.value;$('#tb').innerHTML=rows()};const z=$('#dz');z.onclick=()=>$('#fi').click();z.ondragover=e=>{e.preventDefault();z.classList.add('h')};z.ondragleave=()=>z.classList.remove('h');z.ondrop=e=>{e.preventDefault();z.classList.remove('h');up(e.dataTransfer.files)}}scrollTo(0,0)};
const OK='html css js json lua txt png jpg jpeg gif svg webp ico zip md xml pdf woff2 mp4 webm'.split(' ');
const up=fl=>{let n=0,x=0;for(const f of fl){const nm=sn(f.name),e=nm.split('.').pop().toLowerCase();if(!nm.includes('.')||!OK.includes(e)||f.size>50*1048576){x++;continue}F.push({n:nm,t:e.toUpperCase(),s:f.size/1024,m:'Just now',o:f});n++}T(n?`${n} file(s) uploaded${x?`, ${x} blocked`:''}`:`Blocked: unsupported or oversized file`);if(page=='files')go('files')};
$('#fi').onchange=e=>{up(e.target.files);e.target.value=''};
const pform=i=>{const p=P[i]||{n:'',d:'',t:'Static site',v:'Private'};M(`<h3>${P[i]?'Project Settings':'Create Project'}</h3><label>Project Name<input id="pn" value="${E(p.n)}" ${P[i]?'disabled':''}></label><label>Description<input id="pd" value="${E(p.d)}"></label><label>Project Type<select id="pt">${['Static site','Web app','Assets / CDN','Lua scripts'].map(t=>`<option ${t==p.t?'selected':''}>${t}</option>`).join('')}</select></label><label>Visibility<select id="pv"><option>Private</option><option>Public</option></select></label><label>Custom Domain<input id="pc" placeholder="optional"></label><label>Entry File<input id="pe2" value="index.html"></label><div class="err" id="me"></div><div class="acts"><button class="bt" data-a="ps" data-i="${P[i]?i:-1}">${P[i]?'Save':'Create'}</button><button class="bt s" data-a="x">Cancel</button></div>`)};
const A={go:i=>go(i),menu:()=>$('#sb').classList.toggle('o'),x:()=>$('#md').className='',ok:()=>{cbk($('#ai').value.trim());A.x()},
out:()=>{clearInterval(tm);$('#app').hidden=true;$('#lg').hidden=false;$('#p').value=''},lo:()=>T('Other sessions signed out (needs backend to take effect)'),sv:()=>T('Settings saved locally in preview'),
pw:()=>{const a=$('#np').value,e=$('#pe');e.textContent=!$('#cp').value?'Enter your current password.':a.length<12?'Use at least 12 characters.':a!=$('#np2').value?'Passwords do not match.':'';if(!e.textContent){['cp','np','np2'].forEach(i=>$('#'+i).value='');T('Preview only: password changes are applied by the backend')}},
newp:()=>pform(-1),pSettings:i=>pform(+i),pOpen:i=>T(`https://${P[i].n}.akimbo.host`),pDeploy:i=>{cur=+i;go('deployments')},pFiles:()=>go('files'),
pDelete:i=>M(`<h3>Delete ${E(P[i].n)}?</h3><p class="mu">This permanently removes the project and its files.</p><div class="acts"><button class="bt dg" data-a="pdc" data-i="${i}">Delete</button><button class="bt s" data-a="x">Cancel</button></div>`),pdc:i=>{P.splice(i,1);A.x();go('projects')},
ps:i=>{i=+i;const n=i<0?$('#pn').value.trim().toLowerCase().replace(/[^a-z0-9-]/g,'-').replace(/^-+|-+$/g,''):P[i].n;if(n.length<2||n.length>30||P.some((p,j)=>p.n==n&&j!=i)){$('#me').textContent='Use a unique name, 2–30 letters, numbers or dashes.';return}const o={n,d:$('#pd').value.slice(0,120),t:$('#pt').value,v:$('#pv').value,s:'0 KB',b:'0 B',r:'0',rt:'—',dp:'never',c:new Date().toLocaleDateString('en-US',{month:'short',day:'2-digit',year:'numeric'})};if(i<0)P.unshift(o);else Object.assign(P[i],{d:o.d,t:o.t,v:o.v});A.x();go('projects')},
up:()=>$('#fi').click(),nf:()=>ask('New folder','',v=>{v=sn(v);if(v){F.unshift({n:v,t:'Folder',s:0,m:'Just now',d:1});go('files')}}),
fPreview:i=>{const f=F[i];M(`<h3>${E(f.n)}</h3><div class="row"><span class="mu">Type</span>${f.t}</div><div class="row"><span class="mu">Size</span>${f.d?'—':fs(f.s)}</div><div class="row"><span class="mu">URL</span><span class="url" style="margin:0">https://${P[0]?P[0].n:'project'}.akimbo.host/${E(f.p?f.p+'/':'')}${E(f.n)}</span></div>${f.o&&f.o.type.startsWith('image/')?`<img src="${URL.createObjectURL(f.o)}" style="max-width:100%;border-radius:10px;margin-top:10px">`:''}<div class="acts"><button class="bt s" data-a="x">Close</button></div>`)},
fURL:async i=>{const f=F[i],u=`https://${P[0]?P[0].n:'project'}.akimbo.host/${f.p?f.p+'/':''}${f.n}`;try{await navigator.clipboard.writeText(u);T('URL copied')}catch(e){T(u)}},
fRename:i=>ask('Rename',F[i].n,v=>{v=sn(v);if(v){F[i].n=v;go('files')}}),fMove:i=>ask('Move to folder',F[i].p||'assets',v=>{F[i].p=sn(v);T(`Moved to /${F[i].p}`)}),
fDownload:i=>{const f=F[i];if(f.d)return T('Folders cannot be downloaded directly');const a=document.createElement('a');a.href=URL.createObjectURL(f.o||new Blob(['/* demo file */']));a.download=f.n;a.click()},
fDelete:i=>{F.splice(i,1);go('files')},
run:()=>{const b=$('#db');b.disabled=true;$('#dr').innerHTML='';const n=$('#dp').value,L=[['[OK] Upload complete'],['[OK] Files processed'],['[OK] Build finished'],['[OK] Deployment created','[OK] Hosting configuration updated'],['[OK] Project is now online']],g=$('#lgp'),s=[...document.querySelectorAll('#sg span')];g.textContent='';s.forEach(e=>e.classList.remove('on'));let i=0;const t=setInterval(()=>{s[i].classList.add('on');g.textContent+=L[i].join('\n')+'\n';if(++i==5){clearInterval(t);DH.unshift({p:n,t:'just now',s:'Success'});$('#dr').innerHTML=`<div class="win"><b class="ok">Deployment Successful</b><span class="url">https://${E(n)}.akimbo.host</span></div>`;b.disabled=false}},900)},
nd:()=>ask('Add domain','',v=>{v=v.toLowerCase();if(!/^([a-z0-9-]+\.)+[a-z]{2,}$/.test(v))return T('Enter a valid domain');DM.push({d:v,s:'Pending',l:'Not issued'});go('domains')}),
dv:i=>{DM[i].s='Verified';DM[i].l='Active';go('domains');T('Domain verified (demo)')},dd:i=>{DM.splice(i,1);go('domains')},
rg:i=>{rg=i;go('analytics')},
nk:()=>ask('Key name','',v=>{if(!v)return;const a=new Uint8Array(24);crypto.getRandomValues(a);const s='ak_live_'+[...a].map(x=>x.toString(16).padStart(2,'0')).join('');K.unshift({n:v.slice(0,40),p:['read'],u:'0',k:s.slice(0,8)+'••••'+s.slice(-4)});go('api');M(`<h3>Copy your secret key now</h3><p class="mu">It will not be shown again.</p><pre style="min-height:0;word-break:break-all">${s}</pre><div class="acts"><button class="bt s" data-a="x">I've saved it</button></div>`)}),
kr:i=>ask('Rename key',K[i].n,v=>{if(v){K[i].n=v.slice(0,40);go('api')}}),kd:i=>{K.splice(i,1);go('api')}};
document.addEventListener('click',e=>{const a=e.target.closest('[data-a]');if(a&&A[a.dataset.a])A[a.dataset.a](a.dataset.i);else if(e.target.id=='md')A.x()});
$('#lf').onsubmit=e=>{e.preventDefault();if($('#u').value.trim()!='KyleXAkimbo'||!$('#p').value){$('#le').textContent='Invalid username or password.';return}$('#le').textContent='';$('#lg').hidden=true;$('#app').hidden=false;go('dashboard')};
(()=>{const c=$('#cv'),x=c.getContext('2d');let w,h,n=[];const r=()=>{w=c.width=innerWidth;h=c.height=innerHeight;n=Array.from({length:Math.min(46,w/24|0)},()=>({x:Math.random()*w,y:Math.random()*h,a:(Math.random()-.5)*.4,b:(Math.random()-.5)*.4}))};r();addEventListener('resize',r);const f=()=>{if($('#lg').hidden)return requestAnimationFrame(f);x.clearRect(0,0,w,h);n.forEach((p,i)=>{p.x=(p.x+p.a+w)%w;p.y=(p.y+p.b+h)%h;x.fillStyle='#e11d48';x.fillRect(p.x,p.y,2,2);for(let j=i+1;j<n.length;j++){const d=Math.hypot(p.x-n[j].x,p.y-n[j].y);if(d<130){x.strokeStyle=`rgba(225,29,72,${.25*(1-d/130)})`;x.beginPath();x.moveTo(p.x,p.y);x.lineTo(n[j].x,n[j].y);x.stroke()}}});requestAnimationFrame(f)};f()})();
</script></body></html>
